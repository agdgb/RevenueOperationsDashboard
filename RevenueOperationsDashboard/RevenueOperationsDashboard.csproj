<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="HumanNumbers" Version="2.0.2" />
    <PackageReference Include="HumanNumbers.AspNetCore" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevenueOperationsDashboard.Infrastructure\RevenueOperationsDashboard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Safeguard against test/scratch files ever leaking into publish packages -->
    <Content Remove="wwwroot\*.ps1" />
    <Content Remove="wwwroot\*sample*.html" />
    <Content Remove="**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SETTINGS_GUIDE.md" CopyToPublishDirectory="Always" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
