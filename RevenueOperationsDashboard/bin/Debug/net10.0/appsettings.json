{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=dashboard;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "DashboardSettings": {
    "DefaultFilters": {
      "FiscalYearId": "2018",
      "ParentId": "ALL",
      "PlanItemId": "ALL"
    },
    "Carousel": {
      "AutoPlay": true,
      "IntervalMs": 30000,
      "Slides": [
        {
          "Id": "slide-0",
          "Visible": true,
          "Title": "አፈፃፀም በታክስ ዓይነቶች (Tax Type Performance)",
          "Subtitle": "Comparison of Plan Target vs Actual Performance",
          "ApiEndpoint": "/api/dashboard/tax-type-performance",
          "ComparisonMode": "None",
          "ChartType": "bar-horizontal-grouped",
          "DurationMs": 30000
        },
        {
          "Id": "slide-1",
          "Visible": true,
          "Title": "የዕቅድ ክንውን ወርሃዊ አዝማሚያ (Monthly Achievement Trend)",
          "Subtitle": "Monthly Cumulative Achievement Trend % against 100% target baseline",
          "ApiEndpoint": "/api/dashboard/monthly-trend",
          "ComparisonMode": "None",
          "ChartType": "line-smooth",
          "DurationMs": 30000
        },
        {
          "Id": "slide-2",
          "Visible": true,
          "Title": "የገቢ አፈፃፀም በቅርንጫፍ ጽ/ቤት",
          "Subtitle": "Comparing target achievement percentages across all branch offices",
          "ApiEndpoint": "/api/dashboard/branch-ranking",
          "ComparisonMode": "None",
          "ChartType": "bar-vertical",
          "DurationMs": 30000
        },
        {
          "Id": "slide-3",
          "Visible": false,
          "Title": "የቅርንጫፎች የዕቅድ ክንውን ደረጃ (Branch Performance Leaderboard)",
          "Subtitle": "Top Performing and Attention-Needing Branch Offices by overall target achievement %",
          "ApiEndpoint": "/api/dashboard/branch-ranking",
          "ComparisonMode": "None",
          "ChartType": "leaderboard-split",
          "DurationMs": 30000
        }
      ]
    }
  }
}